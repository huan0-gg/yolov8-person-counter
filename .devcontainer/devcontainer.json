{
  "name": "YOLOv8 人员到岗统计",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // 首次创建容器时安装依赖（CPU 版 torch 单独装，避免拉 CUDA 轮子）
  "postCreateCommand": "bash scripts/dev_setup.sh",

  // 每次启动自动拉起服务，端口 7860 对外公开
  "postStartCommand": "bash scripts/dev_start.sh",

  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Gradio 界面",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },

  "containerEnv": {
    "GRADIO_SERVER_NAME": "0.0.0.0",
    "GRADIO_SERVER_PORT": "7860",
    "GRADIO_ANALYTICS_ENABLED": "False",
    "PYTHONUNBUFFERED": "1",
    "OMP_NUM_THREADS": "2"
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
